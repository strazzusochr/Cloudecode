# YaCy Search Server Configuration
# Copy this file to .env and adjust the values

# YaCy Server URL (default: http://localhost:8090)
VITE_YACY_URL=http://localhost:8090

# SearXNG Server URL (optional)
VITE_SEARXNG_URL=http://localhost:8888

# Meilisearch Server URL (optional)
VITE_MEILISEARCH_URL=http://localhost:7700

# Network Visualization Settings
VITE_DEFAULT_NETWORK_TYPE=yacy
VITE_MAX_NODES=500
VITE_SHOW_PARTICLES=true
