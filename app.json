{
  "expo": {
    "name": "Lemmings 3D Clone",
    "slug": "lemmings-3d-clone",
    "version": "2.0.0",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "scheme": "lemmings3d",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cloudecode.lemmings3d"
    },
    "android": {
      "package": "com.cloudecode.lemmings3d",
      "permissions": []
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
